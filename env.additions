# Nối vào cuối .env.example đang có, giữ nguyên quy ước [LIVE]/[PLANNED].
# Sinh giá trị bằng: openssl rand -hex 24
# KHÔNG dùng base64 — ký tự / + = làm vỡ connection URL.

# -----------------------------------------------------------------------------
# 8. DB ROLES  [LIVE]  — phân quyền luồng A/B (I2, I14, I15)
# -----------------------------------------------------------------------------
POSTGRES_PW=
MIGRATOR_PW=          # ohana_migrator — role DUY NHẤT được tạo bảng
SVC_A_PW=             # svc_ohana_ai   — chỉ thấy schema platform
SVC_B_PW=             # svc_seller     — public + platform
MCP_RO_PW=            # mcp_readonly   — chỉ đọc, cho Postgres MCP

# -----------------------------------------------------------------------------
# 9. LANGFUSE  [PLANNED — wire ở A3]  self-host, không dữ liệu nào rời hạ tầng
# -----------------------------------------------------------------------------
LANGFUSE_DB_PW=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
