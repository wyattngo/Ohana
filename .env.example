# Ohana BE — Environment Variables
# Copy to .env (dev) or .env.prod (production) and fill in values

# ── App ──────────────────────────────────────────────────────────────────
ENV=dev
# api/mock_auth.py's dev-login gate reads OHANA_ENV specifically (fail-closed) — keep in sync with ENV.
OHANA_ENV=dev
APP_VERSION=dev
DEV_AUTH_ENABLED=true

# ── Database ─────────────────────────────────────────────────────────────
# Generated: openssl rand -hex 24
POSTGRES_PW=change-me-to-32-char-hex
POSTGRES_DB=ohana
POSTGRES_USER=ohana

# Alembic migrator role password (generated)
MIGRATOR_PW=change-me-to-32-char-hex

# Service A (Tầng 2 chat + Tầng 3 luồng A) password
SVC_A_PW=change-me-to-32-char-hex

# Service B (Tầng 3 luồng B + worker) password
SVC_B_PW=change-me-to-32-char-hex

# MCP readonly role (for external integrations)
MCP_RO_PW=change-me-to-32-char-hex

# ── LLM Chat (Tầng 2) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-
CLAUDE_MODEL_CHAT=claude-3-5-sonnet-20241022
CLAUDE_MODEL_SMART=claude-3-opus-20250219
CLAUDE_CACHE_ENABLED=true
REASONING_MODE=disabled

# ── LLM Embedding (via Together) ─────────────────────────────────────────
TOGETHER_API_KEY=

# ── LLM Gateway (optional) ───────────────────────────────────────────────
# Leave empty to skip; set to use proxy LLM endpoint
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_MODEL=
LLM_GATEWAY_EMBEDDING_MODEL=
LLM_GATEWAY_TIMEOUT_S=30

# ── Langfuse (self-host tracing) ────────────────────────────────────────
# Generated from Langfuse UI (localhost:3000 → Settings → API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_DB_PW=change-me-to-32-char-hex
LANGFUSE_NEXTAUTH_SECRET=change-me-to-32-char-hex
LANGFUSE_SALT=change-me-to-32-char-hex
LANGFUSE_PUBLIC_URL=http://localhost:3000

# ── Text-to-Speech (optional) ───────────────────────────────────────────
ELEVENLABS_API_KEY=
TTS_MODEL=eleven_monolingual_v1
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
TTS_MAX_CHARS_PER_USER_PER_DAY=10000

# ── Local LLM Fallback (optional) ───────────────────────────────────────
# Use Ollama for local LLM inference if Anthropic is down
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2:13b

# ── Ports (dev only) ────────────────────────────────────────────────────
OHANA_PG_PORT=5432
OHANA_REDIS_PORT=6379

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database URL (auto-derived) ─────────────────────────────────────────
# Dev: set per-role before running each process
# DATABASE_URL=postgresql+psycopg://ohana_migrator:${MIGRATOR_PW}@localhost:5432/ohana
