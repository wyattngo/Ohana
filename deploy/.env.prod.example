# Copy sang `.env.prod` (root repo), điền giá trị, KHÔNG commit.
# `docker-compose.prod.yml` đọc file này qua `env_file: [.env.prod]` + `${VAR}` cho
# 4 password DB (dùng ở top-level, cần trong env shell, không phải chỉ trong service).
#
# Sinh password HEX (base64 vỡ URL vì có `/` `+` `=`):
#   for k in POSTGRES_PW MIGRATOR_PW SVC_A_PW SVC_B_PW MCP_RO_PW \
#            LANGFUSE_DB_PW LANGFUSE_NEXTAUTH_SECRET LANGFUSE_SALT; do
#     echo "$k=$(openssl rand -hex 24)"
#   done

# ── 1. App ───────────────────────────────────────────────────────────────────
ENV=prod
APP_VERSION=                  # git rev-parse --short HEAD
DEV_AUTH_ENABLED=false        # prod: false (mock_authorize DISABLED)

# ── 2. Postgres cluster (bootstrap + migrate + 3 backend service) ────────────
POSTGRES_PW=
MIGRATOR_PW=
SVC_A_PW=                     # svc_ohana_ai — Tầng 2 + Tầng 3 luồng A
SVC_B_PW=                     # svc_seller  — Tầng 3 luồng B + worker
MCP_RO_PW=                    # mcp_readonly (I15)

# ── 3. LLM chat (Anthropic) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL_CHAT=claude-sonnet-4-5
CLAUDE_MODEL_SMART=claude-opus-4-5
CLAUDE_CACHE_ENABLED=true
REASONING_MODE=auto

# ── 4. LLM embedding (Together) ──────────────────────────────────────────────
TOGETHER_API_KEY=
# Model pin trong code: intfloat/multilingual-e5-large-instruct · 1024d

# ── 5. LLM gateway (optional — bỏ nếu không proxy) ───────────────────────────
LLM_GATEWAY_ENABLED=false
LLM_GATEWAY_BASE_URL=
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_CHAT_MODEL=
LLM_GATEWAY_EMBED_MODEL=

# ── 6. Langfuse (self-host v2, mint keys ở UI sau khi compose lên) ───────────
LANGFUSE_DB_PW=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_PUBLIC_URL=http://localhost:3000   # NEXTAUTH_URL — nếu proxy Langfuse ra domain khác, đổi
LANGFUSE_HOST=http://langfuse:3000          # backend đọc — container-to-container
LANGFUSE_PUBLIC_KEY=                        # mint qua UI, xem DEPLOY.md §6
LANGFUSE_SECRET_KEY=

# ── 7. TTS (optional — ElevenLabs) ───────────────────────────────────────────
ELEVENLABS_API_KEY=
TTS_MODEL=
TTS_VOICE_ID=
TTS_MAX_CHARS_PER_USER_PER_DAY=10000

# ── 8. Ollama fallback (optional) ────────────────────────────────────────────
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# ── 9. GitHub (nếu bridge cần) ───────────────────────────────────────────────
GITHUB_REPOSITORY=
